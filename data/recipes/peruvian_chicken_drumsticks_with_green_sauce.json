{"metadata":{"map":{"Title":"Peruvian Chicken Drumsticks with Green Sauce","Servings":"4 People","Tags":"Prospects, Peruvian, Chicken, Drumsticks, Grilled","Link":"https://overthefirecooking.com/butterflied-peruvian-chicken-drumsticks-with-green-sauce/"}},"sections":[{"name":null,"content":[{"type":"step","value":{"items":[{"type":"text","value":"Begin prepping your "},{"type":"ingredient","index":0},{"type":"text","value":". Using a really sharp knife, slice one area on the drumstick from top to bottom all the way down to the bone."}],"number":1}},{"type":"step","value":{"items":[{"type":"text","value":"Pull apart the two sides of the slice and begin separating the meat from the bone so that the chicken drumstick is flayed open and flat. Make sure to leave some part of the meat, on the opposite side of the first cut, still connected. Repeat this for all of your drumsticks."}],"number":2}},{"type":"step","value":{"items":[{"type":"text","value":"In a "},{"type":"cookware","index":0},{"type":"text","value":", add all the ingredients for the marinade: "},{"type":"ingredient","index":1},{"type":"text","value":", "},{"type":"ingredient","index":2},{"type":"text","value":", "},{"type":"ingredient","index":3},{"type":"text","value":", "},{"type":"ingredient","index":4},{"type":"text","value":", "},{"type":"ingredient","index":5},{"type":"text","value":", "},{"type":"ingredient","index":6},{"type":"text","value":", "},{"type":"ingredient","index":7},{"type":"text","value":", "},{"type":"ingredient","index":8},{"type":"text","value":", "},{"type":"ingredient","index":9},{"type":"text","value":", and "},{"type":"ingredient","index":10},{"type":"text","value":". Blend until smooth."}],"number":3}},{"type":"step","value":{"items":[{"type":"text","value":"Add all of your chicken drumsticks to a food safe "},{"type":"cookware","index":1},{"type":"text","value":" or bag and pour the marinade over top (make sure to save 2-3oz of marinade for basting later). Mix together thoroughly, cover and place in the fridge to marinate for "},{"type":"timer","index":0},{"type":"text","value":" but ideally overnight."}],"number":4}},{"type":"step","value":{"items":[{"type":"text","value":"The following day, preheat a medium-high heat fire (around 350-375 degrees F) for direct cooking."}],"number":5}},{"type":"step","value":{"items":[{"type":"text","value":"In a "},{"type":"cookware","index":2},{"type":"text","value":", add all the ingredients for the Green Sauce: "},{"type":"ingredient","index":11},{"type":"text","value":", "},{"type":"ingredient","index":12},{"type":"text","value":", "},{"type":"ingredient","index":13},{"type":"text","value":", "},{"type":"ingredient","index":14},{"type":"text","value":", "},{"type":"ingredient","index":15},{"type":"text","value":", "},{"type":"ingredient","index":16},{"type":"text","value":", "},{"type":"ingredient","index":17},{"type":"text","value":", and "},{"type":"ingredient","index":18},{"type":"text","value":". Blend until smooth and set aside until ready to use."}],"number":6}},{"type":"step","value":{"items":[{"type":"text","value":"Pull your drumsticks out of the marinade and discard any excess marinade."}],"number":7}},{"type":"step","value":{"items":[{"type":"text","value":"Place them onto the grill and cook them for "},{"type":"timer","index":1},{"type":"text","value":" until they reach 170F internal. Make sure to flip them every "},{"type":"timer","index":2},{"type":"text","value":" to prevent burning, and move the chicken around in case you have a hotter spot on your grill."}],"number":8}},{"type":"step","value":{"items":[{"type":"text","value":"Right before they are done, baste the outside of the meat with the reserved marinade. Once done, pull them off and let them rest for "},{"type":"timer","index":3},{"type":"text","value":"."}],"number":9}},{"type":"step","value":{"items":[{"type":"text","value":"Drizzle the green sauce over the top of the drumsticks or serve on the side."}],"number":10}}]}],"ingredients":[{"name":"Chicken Drumsticks","alias":null,"quantity":{"value":{"type":"text","value":"12-15"},"unit":null,"scalable":false},"note":null,"reference":null,"relation":{"relation":{"type":"definition","referenced_from":[],"defined_in_step":true},"reference_target":null},"modifiers":""},{"name":"Cilantro","alias":null,"quantity":{"value":{"type":"text","value":"1 cup"},"unit":null,"scalable":false},"note":null,"reference":null,"relation":{"relation":{"type":"definition","referenced_from":[],"defined_in_step":true},"reference_target":null},"modifiers":""},{"name":"Garlic Cloves","alias":null,"quantity":{"value":{"type":"text","value":"8-10"},"unit":null,"scalable":false},"note":null,"reference":null,"relation":{"relation":{"type":"definition","referenced_from":[],"defined_in_step":true},"reference_target":null},"modifiers":""},{"name":"Limes","alias":null,"quantity":{"value":{"type":"text","value":"4 medium"},"unit":null,"scalable":false},"note":null,"reference":null,"relation":{"relation":{"type":"definition","referenced_from":[],"defined_in_step":true},"reference_target":null},"modifiers":""},{"name":"Soy Sauce","alias":null,"quantity":{"value":{"type":"text","value":"2.5 tbsp"},"unit":null,"scalable":false},"note":null,"reference":null,"relation":{"relation":{"type":"definition","referenced_from":[],"defined_in_step":true},"reference_target":null},"modifiers":""},{"name":"Aji Amarillo Paste","alias":null,"quantity":{"value":{"type":"text","value":"1.5 tbsp"},"unit":null,"scalable":false},"note":null,"reference":null,"relation":{"relation":{"type":"definition","referenced_from":[],"defined_in_step":true},"reference_target":null},"modifiers":""},{"name":"Aji Panca Paste","alias":null,"quantity":{"value":{"type":"text","value":"1.5 tbsp"},"unit":null,"scalable":false},"note":null,"reference":null,"relation":{"relation":{"type":"definition","referenced_from":[],"defined_in_step":true},"reference_target":null},"modifiers":""},{"name":"Ground Cumin","alias":null,"qua