{"metadata":{"map":{"Title":"Surf and Turf Smashburger Tacos","Servings":"4 People","Tags":"Prospects, American, Beef, Ground Beef, Shrimp, Tacos, Grilled","Link":"https://overthefirecooking.com/surf-and-turf-smashburger-tacos/#wprm-recipe-container-23326"}},"sections":[{"name":null,"content":[{"type":"step","value":{"items":[{"type":"text","value":"Fire up the "},{"type":"cookware","index":0},{"type":"text","value":". Light the coals and set up the grill for 2-zone cooking, placing the hot coals on one side only. Spread the coals evenly when ready and allow the grill to preheat."}],"number":1}},{"type":"step","value":{"items":[{"type":"text","value":"Mix the ingredients for the Chipotle Mayo in a "},{"type":"cookware","index":1},{"type":"text","value":": "},{"type":"ingredient","index":0},{"type":"text","value":", chopped "},{"type":"ingredient","index":1},{"type":"text","value":", "},{"type":"ingredient","index":2},{"type":"text","value":", and "},{"type":"ingredient","index":3},{"type":"text","value":". Taste and adjust as needed."}],"number":2}},{"type":"step","value":{"items":[{"type":"text","value":"Portion the "},{"type":"ingredient","index":4},{"type":"text","value":" into golf-ball sized portions (roughly 2 ounces each). Using wax paper, press the meat directly into the "},{"type":"ingredient","index":5},{"type":"text","value":", pushing the beef out to the edges of the tortillas. Season the meat as needed with "},{"type":"ingredient","index":6},{"type":"text","value":" (split between beef and shrimp)."}],"number":3}},{"type":"step","value":{"items":[{"type":"text","value":"Prepare the shrimp skewers. Place the cleaned and shelled "},{"type":"ingredient","index":7},{"type":"text","value":" in a "},{"type":"cookware","index":2},{"type":"text","value":". Pour in "},{"type":"ingredient","index":8},{"type":"text","value":" and add enough of the remaining "},{"type":"ingredient","index":9},{"type":"text","value":" to coat the shrimp. Mix them around to spread the seasoning, and thread them onto "},{"type":"cookware","index":3},{"type":"text","value":". If using wood skewers, make sure they soak in water prior to grilling."}],"number":4}},{"type":"step","value":{"items":[{"type":"text","value":"Place the tacos on the grill over the coals, 2 at a time. Cook for "},{"type":"timer","index":0},{"type":"text","value":", watching closely, then flip them to the cool side of the grill and allow them to rest. The ambient heat will continue to cook the backside without charring the tortillas. Repeat the process for the rest of the tacos."}],"number":5}},{"type":"step","value":{"items":[{"type":"text","value":"Clean the grill grates and place the shrimp skewers on the grill. Cook for "},{"type":"timer","index":1},{"type":"text","value":" per side, or until they are charred and reach 120°F internal temperature."}],"number":6}},{"type":"step","value":{"items":[{"type":"text","value":"Build the tacos by placing the cooked shrimp on top of the smashburger tacos and filling with chopped "},{"type":"ingredient","index":10},{"type":"text","value":", "},{"type":"ingredient","index":11},{"type":"text","value":", and the prepared Chipotle Mayo."}],"number":7}}]}],"ingredients":[{"name":"Mayonnaise","alias":null,"quantity":{"value":{"type":"text","value":"3/4 cup"},"unit":null,"scalable":false},"note":null,"reference":null,"relation":{"relation":{"type":"definition","referenced_from":[],"defined_in_step":true},"reference_target":null},"modifiers":""},{"name":"Chipotles in Adobo","alias":null,"quantity":{"value":{"type":"text","value":"1 tbsp"},"unit":null,"scalable":false},"note":null,"reference":null,"relation":{"relation":{"type":"definition","referenced_from":[],"defined_in_step":true},"reference_target":null},"modifiers":""},{"name":"Lime Juice","alias":null,"quantity":{"value":{"type":"number","value":{"type":"regular","value":1.0}},"unit":null,"scalable":true},"note":null,"reference":null,"relation":{"relation":{"type":"definition","refere